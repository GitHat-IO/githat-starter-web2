# Copy to .env.local for your machine; in production set these in your host's settings. Never commit real values.

# 1. Sessions: any long random string (openssl rand -hex 32).
SESSION_SECRET=

# 2. Google sign-in: a Google Cloud OAuth client (Web application). Add <your site>/api/auth/google/callback
#    to its Authorized redirect URIs (http://localhost:3000/api/auth/google/callback for local work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. Card payments through SebasTN: your merchant id from https://sebastn.com after you connect Stripe.
NEXT_PUBLIC_SEBASTN_MERCHANT=

# 4. Pay per call (x402): YOUR wallet address that receives payments (public address only, never a private key).
#    Base Sepolia, a test network.
X402_PAY_TO=
# Optional: another x402 facilitator (default https://x402.org/facilitator).
# X402_FACILITATOR_URL=
